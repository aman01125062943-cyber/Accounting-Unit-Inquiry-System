App.prototype.downloadSalaryTemplate = function () {
    const headers = [
        'ظƒظˆط¯ ط§ظ„ظ…ظ„ظپ',
        'ط§ظ„ط§ط³ظ€ظ€ظ€ظ€ظ…',
        'ط§ظ„ط±ظ‚ظ… ط§ظ„ظ‚ظˆظ…ظٹ',
        'ط±ظ‚ظ… ط§ظ„ط­ط³ط§ط¨',
        'ط§ظ„ط¨ظ†ظƒ',
        'ظ‚ظٹظ…ط© ط§ظ„ط¹ظ…ظ„ظٹط©',
        'ط§ظ„ط­ط§ظ„ط©',
        'ط§ظ„ط³ط¨ط¨',
        'ط±ظ‚ظ… ط§ظ„ط­ط³ط§ط¨ ط¨ط¹ط¯ ط§ظ„طھط¹ط¯ظٹظ„',
        'ط§ظ„ط¨ظ†ظƒ ط¨ط¹ط¯ ط§ظ„طھط¹ط¯ظٹظ„',
        'ظƒظˆط¯ ط§ظ„ظپط±ط¹ ط¨ط¹ط¯ ط§ظ„طھط¹ط¯ظٹظ„',
        'ط±ظ‚ظ… ط§ظ„طھط¹ظ„ظٹط©',
        'طھط§ط±ظٹط® ط§ظ„طھط¹ظ„ظٹط©',
        'طھط§ط±ظٹط® ط§ظ„ط§ط±طھط¯ط§ط¯',
        'طھط§ط±ظٹط® ط§ط¹طھظ…ط§ط¯ ط§ظ„ظ…ط±طھط¯ط§طھ',
        'طھط§ط±ظٹط® ط§ظ„طھط¹ط¯ظٹظ„',
        'طھط§ط±ظٹط® ط§ط¹طھظ…ط§ط¯ ط§ظ„طھط¹ط¯ظٹظ„',
        'ط±ظ‚ظ… طھط³ظˆظٹط© ط§ظ„ط³ط¯ط§ط¯',
        'طھط§ط±ظٹط® طھط³ظˆظٹط© ط§ظ„ط³ط¯ط§ط¯'
    ];
    
    // ط¥ظ†ط´ط§ط، ظˆط±ظ‚ط© ط§ظ„ط¹ظ…ظ„ ط¨طµظپظˆظپ ظپط§ط±ط؛ط© (ط±ط¤ظˆط³ ظپظ‚ط·)
    const ws = XLSX.utils.aoa_to_sheet([headers]);
    const wb = XLSX.utils.book_new();
