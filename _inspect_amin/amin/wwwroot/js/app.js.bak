    XLSX.writeFile(wb, "Salary_Returns_Template.xlsx");
    this.showToast('طھظ… طھط­ظ…ظٹظ„ ظ†ظ…ظˆط°ط¬ ط§ظ„ظ…ط±طھط¨ط§طھ ط¨ظ†ط¬ط§ط­', 'success');
};

